generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  CREDIT_CARD
  DIGITAL_WALLET
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanType {
  RECEIVABLE
  PAYABLE
}

enum LoanStatus {
  OPEN
  PAID
}

enum EmailCodePurpose {
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
}

enum UserRole {
  ADMIN
  BODEGA
  SUPERADMIN
}

enum IncomeType {
  ADVANCE
  RECEIVABLE_PAYMENT
}

enum PaymentMethod {
  CASH
  BANK
}

enum OrderPaymentMethod {
  CASH
  BANK
  CREDIT
}

enum RecordStatus {
  ACTIVE
  VOID
}

enum InventoryMovementType {
  ENTRY
  ORDER
  ORDER_VOID
}

model User {
  id                 String                  @id @default(uuid())
  name               String
  email              String                  @unique
  username           String                  @unique
  passwordHash       String                  @map("password_hash")
  role               UserRole                @default(BODEGA)
  pointOfSaleId      String?                 @map("point_of_sale_id")
  isActive           Boolean                 @default(true) @map("is_active")
  emailVerifiedAt    DateTime?               @map("email_verified_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  transfers          Transfer[]
  loans              Loan[]
  loanPayments       LoanPayment[]
  clients            Client[]                @relation("ClientCreator")
  expenseCategories  ExpenseCategory[]       @relation("ExpenseCategoryCreator")
  incomes            Income[]                @relation("IncomeCreator")
  expenses           Expense[]               @relation("ExpenseCreator")
  products           Product[]               @relation("ProductCreator")
  orders             Order[]                 @relation("OrderCreator")
  voidedOrders       Order[]                 @relation("OrderVoidUser")
  inventoryEntries   InventoryEntry[]
  inventoryMovements InventoryMovement[]
  voidedIncomes      Income[]                @relation("IncomeVoidUser")
  voidedExpenses     Expense[]               @relation("ExpenseVoidUser")
  refreshTokens      RefreshToken[]
  emailCodes         EmailVerificationCode[]
  pointOfSale        PointOfSale?            @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)

  @@index([pointOfSaleId])
  @@map("users")
}

model PointOfSale {
  id                       String              @id @default(uuid())
  name                     String
  code                     String              @unique
  documentPrefix           String              @unique @map("document_prefix")
  nextIncomeNumber         Int                 @default(1) @map("next_income_number")
  nextExpenseNumber        Int                 @default(1) @map("next_expense_number")
  nextOrderNumber          Int                 @default(1) @map("next_order_number")
  nextInventoryEntryNumber Int                 @default(1) @map("next_inventory_entry_number")
  city                     String?
  address                  String?             @db.VarChar(300)
  isActive                 Boolean             @default(true) @map("is_active")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  users                    User[]
  incomes                  Income[]
  expenses                 Expense[]
  orders                   Order[]
  priceListPrices          PointOfSalePrice[]
  inventoryStocks          InventoryStock[]
  inventoryEntries         InventoryEntry[]
  inventoryMovements       InventoryMovement[]

  @@index([isActive])
  @@map("points_of_sale")
}

model Supplier {
  id             String             @id @default(uuid())
  name           String
  normalizedName String             @unique @map("normalized_name")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  products       PriceListProduct[]

  @@index([isActive])
  @@map("suppliers")
}

model PriceListCategory {
  id             String             @id @default(uuid())
  name           String
  normalizedName String             @unique @map("normalized_name")
  sortOrder      Int                @default(0) @map("sort_order")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  products       PriceListProduct[]

  @@index([isActive, sortOrder])
  @@map("price_list_categories")
}

model PriceListProduct {
  id                    String             @id @default(uuid())
  sourceKey             String             @unique @map("source_key") @db.VarChar(600)
  categoryId            String             @map("category_id")
  supplierId            String             @map("supplier_id")
  reference             String             @db.VarChar(500)
  measure               String?            @db.VarChar(300)
  presentation          String?            @db.VarChar(300)
  primaryPriceLabel     String             @map("primary_price_label")
  secondaryPriceLabel   String             @map("secondary_price_label")
  defaultPrimaryPrice   Decimal?           @map("default_primary_price") @db.Decimal(14, 2)
  defaultSecondaryPrice Decimal?           @map("default_secondary_price") @db.Decimal(14, 2)
  defaultPrimaryNote    String?            @map("default_primary_note") @db.VarChar(300)
  defaultSecondaryNote  String?            @map("default_secondary_note") @db.VarChar(300)
  sourceSheet           String?            @map("source_sheet")
  sourceRow             Int?               @map("source_row")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  category              PriceListCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier              Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  prices                PointOfSalePrice[]

  @@index([categoryId, isActive])
  @@index([supplierId, isActive])
  @@map("price_list_products")
}

model PointOfSalePrice {
  id                 String           @id @default(uuid())
  pointOfSaleId      String           @map("point_of_sale_id")
  productId          String           @map("product_id")
  primaryPrice       Decimal?         @map("primary_price") @db.Decimal(14, 2)
  secondaryPrice     Decimal?         @map("secondary_price") @db.Decimal(14, 2)
  primaryPriceNote   String?          @map("primary_price_note") @db.VarChar(300)
  secondaryPriceNote String?          @map("secondary_price_note") @db.VarChar(300)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  pointOfSale        PointOfSale      @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  product            PriceListProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pointOfSaleId, productId])
  @@index([productId])
  @@map("point_of_sale_prices")
}

model Client {
  id                  String   @id @default(uuid())
  fullName            String   @map("full_name")
  identityDocument    String   @map("identity_document")
  identityDocumentKey String   @unique @map("identity_document_key")
  isActive            Boolean  @default(true) @map("is_active")
  createdByUserId     String?  @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           User?    @relation("ClientCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  incomes             Income[]
  orders              Order[]

  @@map("clients")
}

model ExpenseCategory {
  id              String    @id @default(uuid())
  name            String    @unique
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       User?     @relation("ExpenseCategoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  expenses        Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

model Income {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  pointOfSaleId    String?       @map("point_of_sale_id")
  clientId         String        @map("client_id")
  clientName       String        @map("client_name")
  clientDocument   String        @map("client_document")
  documentSequence Int           @map("document_sequence")
  documentNumber   String        @unique @map("document_number")
  type             IncomeType
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(14, 2)
  description      String?
  incomeDate       DateTime      @map("income_date")
  status           RecordStatus  @default(ACTIVE)
  causedAt         DateTime?     @map("caused_at")
  voidReason       String?       @map("void_reason")
  voidedAt         DateTime?     @map("voided_at")
  voidedByUserId   String?       @map("voided_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  user             User          @relation("IncomeCreator", fields: [userId], references: [id], onDelete: Cascade)
  pointOfSale      PointOfSale?  @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  client           Client        @relation(fields: [clientId], references: [id])
  voidedBy         User?         @relation("IncomeVoidUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pointOfSaleId, documentSequence])
  @@index([clientId])
  @@index([type])
  @@index([paymentMethod])
  @@index([status])
  @@index([incomeDate])
  @@index([userId, incomeDate])
  @@map("incomes")
}

model Expense {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  pointOfSaleId       String?         @map("point_of_sale_id")
  categoryId          String          @map("category_id")
  documentSequence    Int             @map("document_sequence")
  documentNumber      String          @unique @map("document_number")
  paidTo              String          @map("paid_to")
  amount              Decimal         @db.Decimal(14, 2)
  appliesRetention    Boolean         @default(false) @map("applies_retention")
  retentionPercentage Decimal?        @map("retention_percentage") @db.Decimal(5, 2)
  retentionAmount     Decimal?        @map("retention_amount") @db.Decimal(14, 2)
  description         String?
  approvedBy          String?         @map("approved_by")
  expenseDate         DateTime        @map("expense_date")
  status              RecordStatus    @default(ACTIVE)
  causedAt            DateTime?       @map("caused_at")
  voidReason          String?         @map("void_reason")
  voidedAt            DateTime?       @map("voided_at")
  voidedByUserId      String?         @map("voided_by_user_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  user                User            @relation("ExpenseCreator", fields: [userId], references: [id], onDelete: Cascade)
  pointOfSale         PointOfSale?    @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  category            ExpenseCategory @relation(fields: [categoryId], references: [id])
  voidedBy            User?           @relation("ExpenseVoidUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pointOfSaleId, documentSequence])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([userId, expenseDate])
  @@map("expenses")
}

model Product {
  id                    String               @id @default(uuid())
  description           String
  normalizedDescription String               @unique @map("normalized_description")
  isActive              Boolean              @default(true) @map("is_active")
  createdByUserId       String?              @map("created_by_user_id")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  createdBy             User?                @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]
  inventoryStocks       InventoryStock[]
  inventoryEntryItems   InventoryEntryItem[]
  inventoryMovements    InventoryMovement[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  pointOfSaleId      String?             @map("point_of_sale_id")
  clientId           String              @map("client_id")
  documentSequence   Int                 @map("document_sequence")
  documentNumber     String              @unique @map("document_number")
  clientName         String              @map("client_name")
  clientDocument     String              @map("client_document")
  deliveryAddress    String?             @map("delivery_address") @db.VarChar(300)
  clientPhone        String?             @map("client_phone") @db.VarChar(50)
  paymentMethod      OrderPaymentMethod? @map("payment_method")
  observations       String?             @db.Text
  totalAmount        Decimal             @map("total_amount") @db.Decimal(14, 2)
  invoicedAt         DateTime?           @map("invoiced_at")
  status             RecordStatus        @default(ACTIVE)
  inventoryAppliedAt DateTime?           @map("inventory_applied_at")
  voidReason         String?             @map("void_reason")
  voidedAt           DateTime?           @map("voided_at")
  voidedByUserId     String?             @map("voided_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User                @relation("OrderCreator", fields: [userId], references: [id], onDelete: Cascade)
  voidedBy           User?               @relation("OrderVoidUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  pointOfSale        PointOfSale?        @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  client             Client              @relation(fields: [clientId], references: [id])
  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([userId])
  @@index([pointOfSaleId, documentSequence])
  @@index([clientId])
  @@index([createdAt])
  @@index([status])
  @@index([voidedByUserId])
  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(uuid())
  orderId            String  @map("order_id")
  productId          String  @map("product_id")
  productDescription String  @map("product_description")
  quantity           Decimal @db.Decimal(12, 3)
  unitPrice          Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(14, 2)
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model InventoryStock {
  id            String      @id @default(uuid())
  pointOfSaleId String      @map("point_of_sale_id")
  productId     String      @map("product_id")
  quantity      Decimal     @default(0) @db.Decimal(14, 3)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pointOfSaleId, productId])
  @@index([productId])
  @@index([pointOfSaleId, isActive])
  @@map("inventory_stocks")
}

model InventoryEntry {
  id                 String               @id @default(uuid())
  userId             String               @map("user_id")
  pointOfSaleId      String               @map("point_of_sale_id")
  documentSequence   Int                  @map("document_sequence")
  documentNumber     String               @unique @map("document_number")
  supplierName       String               @map("supplier_name")
  remittanceNumber   String?              @map("remittance_number")
  observations       String?              @db.Text
  entryDate          DateTime             @map("entry_date")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointOfSale        PointOfSale          @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  items              InventoryEntryItem[]
  inventoryMovements InventoryMovement[]

  @@index([userId])
  @@index([pointOfSaleId, documentSequence])
  @@index([entryDate])
  @@map("inventory_entries")
}

model InventoryEntryItem {
  id                 String         @id @default(uuid())
  inventoryEntryId   String         @map("inventory_entry_id")
  productId          String         @map("product_id")
  productDescription String         @map("product_description")
  quantity           Decimal        @db.Decimal(14, 3)
  inventoryEntry     InventoryEntry @relation(fields: [inventoryEntryId], references: [id], onDelete: Cascade)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([inventoryEntryId])
  @@index([productId])
  @@map("inventory_entry_items")
}

model InventoryMovement {
  id               String                @id @default(uuid())
  pointOfSaleId    String                @map("point_of_sale_id")
  productId        String                @map("product_id")
  userId           String                @map("user_id")
  inventoryEntryId String?               @map("inventory_entry_id")
  orderId          String?               @map("order_id")
  type             InventoryMovementType
  quantityChange   Decimal               @map("quantity_change") @db.Decimal(14, 3)
  balanceAfter     Decimal               @map("balance_after") @db.Decimal(14, 3)
  createdAt        DateTime              @default(now()) @map("created_at")
  pointOfSale      PointOfSale           @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  inventoryEntry   InventoryEntry?       @relation(fields: [inventoryEntryId], references: [id], onDelete: SetNull)
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([pointOfSaleId, createdAt])
  @@index([productId, createdAt])
  @@index([inventoryEntryId])
  @@index([orderId])
  @@map("inventory_movements")
}

model EmailVerificationCode {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  email           String
  purpose         EmailCodePurpose
  codeHash        String           @map("code_hash") @db.Text
  newPasswordHash String?          @map("new_password_hash") @db.Text
  attempts        Int              @default(0)
  expiresAt       DateTime         @map("expires_at")
  usedAt          DateTime?        @map("used_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([userId, purpose, usedAt])
  @@map("email_verification_codes")
}

model Account {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  name              String
  type              AccountType
  initialBalance    Decimal       @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currentBalance    Decimal       @default(0) @map("current_balance") @db.Decimal(14, 2)
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  outgoingTransfers Transfer[]    @relation("OutgoingTransfers")
  incomingTransfers Transfer[]    @relation("IncomingTransfers")
  loans             Loan[]
  loanPayments      LoanPayment[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  name         String
  type         CategoryType
  color        String?
  icon         String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  accountId       String          @map("account_id")
  categoryId      String          @map("category_id")
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  description     String?
  transactionDate DateTime        @map("transaction_date")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([type])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model Transfer {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  transferDate  DateTime @map("transfer_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("OutgoingTransfers", fields: [fromAccountId], references: [id])
  toAccount     Account  @relation("IncomingTransfers", fields: [toAccountId], references: [id])

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transferDate])
  @@index([userId, transferDate])
  @@map("transfers")
}

model Loan {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  accountId       String        @map("account_id")
  personName      String        @map("person_name")
  type            LoanType
  principalAmount Decimal       @map("principal_amount") @db.Decimal(14, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(14, 2)
  description     String?
  loanDate        DateTime      @map("loan_date")
  status          LoanStatus    @default(OPEN)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id])
  payments        LoanPayment[]

  @@index([userId])
  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([loanDate])
  @@index([userId, type, status])
  @@map("loans")
}

model LoanPayment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  loanId      String   @map("loan_id")
  accountId   String   @map("account_id")
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  paymentDate DateTime @map("payment_date")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([loanId])
  @@index([accountId])
  @@index([paymentDate])
  @@map("loan_payments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
