generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  CREDIT_CARD
  DIGITAL_WALLET
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanType {
  RECEIVABLE
  PAYABLE
}

enum LoanStatus {
  OPEN
  PAID
}

enum EmailCodePurpose {
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
}

enum UserRole {
  ADMIN
  BODEGA
}

enum IncomeType {
  ADVANCE
  RECEIVABLE_PAYMENT
}

enum PaymentMethod {
  CASH
  BANK
}

enum RecordStatus {
  ACTIVE
  VOID
}

model User {
  id                String                  @id @default(uuid())
  name              String
  email             String                  @unique
  username          String                  @unique
  passwordHash      String                  @map("password_hash")
  role              UserRole                @default(BODEGA)
  documentSuffix    String                  @unique @map("document_suffix")
  nextIncomeNumber  Int                     @default(1) @map("next_income_number")
  nextExpenseNumber Int                     @default(1) @map("next_expense_number")
  nextOrderNumber   Int                     @default(1) @map("next_order_number")
  isActive          Boolean                 @default(true) @map("is_active")
  emailVerifiedAt   DateTime?               @map("email_verified_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  transfers         Transfer[]
  loans             Loan[]
  loanPayments      LoanPayment[]
  clients           Client[]                @relation("ClientCreator")
  expenseCategories ExpenseCategory[]       @relation("ExpenseCategoryCreator")
  incomes           Income[]                @relation("IncomeCreator")
  expenses          Expense[]               @relation("ExpenseCreator")
  products          Product[]               @relation("ProductCreator")
  orders            Order[]
  voidedIncomes     Income[]                @relation("IncomeVoidUser")
  voidedExpenses    Expense[]               @relation("ExpenseVoidUser")
  refreshTokens     RefreshToken[]
  emailCodes        EmailVerificationCode[]

  @@map("users")
}

model Client {
  id                  String   @id @default(uuid())
  fullName            String   @map("full_name")
  identityDocument    String   @map("identity_document")
  identityDocumentKey String   @unique @map("identity_document_key")
  isActive            Boolean  @default(true) @map("is_active")
  createdByUserId     String?  @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           User?    @relation("ClientCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  incomes             Income[]
  orders              Order[]

  @@map("clients")
}

model ExpenseCategory {
  id              String    @id @default(uuid())
  name            String    @unique
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       User?     @relation("ExpenseCategoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  expenses        Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

model Income {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  clientId         String        @map("client_id")
  clientName       String        @map("client_name")
  clientDocument   String        @map("client_document")
  documentSequence Int           @map("document_sequence")
  documentNumber   String        @unique @map("document_number")
  type             IncomeType
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(14, 2)
  description      String?
  incomeDate       DateTime      @map("income_date")
  status           RecordStatus  @default(ACTIVE)
  causedAt         DateTime?     @map("caused_at")
  voidReason       String?       @map("void_reason")
  voidedAt         DateTime?     @map("voided_at")
  voidedByUserId   String?       @map("voided_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  user             User          @relation("IncomeCreator", fields: [userId], references: [id], onDelete: Cascade)
  client           Client        @relation(fields: [clientId], references: [id])
  voidedBy         User?         @relation("IncomeVoidUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, documentSequence])
  @@index([userId])
  @@index([clientId])
  @@index([type])
  @@index([paymentMethod])
  @@index([status])
  @@index([incomeDate])
  @@index([userId, incomeDate])
  @@map("incomes")
}

model Expense {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  categoryId       String          @map("category_id")
  documentSequence Int             @map("document_sequence")
  documentNumber   String          @unique @map("document_number")
  paidTo           String          @map("paid_to")
  amount           Decimal         @db.Decimal(14, 2)
  description      String?
  approvedBy       String?         @map("approved_by")
  expenseDate      DateTime        @map("expense_date")
  status           RecordStatus    @default(ACTIVE)
  causedAt         DateTime?       @map("caused_at")
  voidReason       String?         @map("void_reason")
  voidedAt         DateTime?       @map("voided_at")
  voidedByUserId   String?         @map("voided_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  user             User            @relation("ExpenseCreator", fields: [userId], references: [id], onDelete: Cascade)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  voidedBy         User?           @relation("ExpenseVoidUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, documentSequence])
  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([userId, expenseDate])
  @@map("expenses")
}

model Product {
  id                    String      @id @default(uuid())
  description           String
  normalizedDescription String      @unique @map("normalized_description")
  isActive              Boolean     @default(true) @map("is_active")
  createdByUserId       String?     @map("created_by_user_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  createdBy             User?       @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  clientId         String         @map("client_id")
  documentSequence Int            @map("document_sequence")
  documentNumber   String         @unique @map("document_number")
  clientName       String         @map("client_name")
  clientDocument   String         @map("client_document")
  deliveryAddress  String?        @map("delivery_address") @db.VarChar(300)
  clientPhone      String?        @map("client_phone") @db.VarChar(50)
  paymentMethod    PaymentMethod? @map("payment_method")
  observations     String?        @db.Text
  totalAmount      Decimal        @map("total_amount") @db.Decimal(14, 2)
  invoicedAt       DateTime?      @map("invoiced_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client           Client         @relation(fields: [clientId], references: [id])
  items            OrderItem[]

  @@unique([userId, documentSequence])
  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(uuid())
  orderId            String  @map("order_id")
  productId          String  @map("product_id")
  productDescription String  @map("product_description")
  quantity           Decimal @db.Decimal(12, 3)
  unitPrice          Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(14, 2)
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model EmailVerificationCode {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  email           String
  purpose         EmailCodePurpose
  codeHash        String           @map("code_hash") @db.Text
  newPasswordHash String?          @map("new_password_hash") @db.Text
  attempts        Int              @default(0)
  expiresAt       DateTime         @map("expires_at")
  usedAt          DateTime?        @map("used_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([userId, purpose, usedAt])
  @@map("email_verification_codes")
}

model Account {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  name              String
  type              AccountType
  initialBalance    Decimal       @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currentBalance    Decimal       @default(0) @map("current_balance") @db.Decimal(14, 2)
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  outgoingTransfers Transfer[]    @relation("OutgoingTransfers")
  incomingTransfers Transfer[]    @relation("IncomingTransfers")
  loans             Loan[]
  loanPayments      LoanPayment[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  name         String
  type         CategoryType
  color        String?
  icon         String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  accountId       String          @map("account_id")
  categoryId      String          @map("category_id")
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  description     String?
  transactionDate DateTime        @map("transaction_date")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([type])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model Transfer {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  transferDate  DateTime @map("transfer_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("OutgoingTransfers", fields: [fromAccountId], references: [id])
  toAccount     Account  @relation("IncomingTransfers", fields: [toAccountId], references: [id])

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transferDate])
  @@index([userId, transferDate])
  @@map("transfers")
}

model Loan {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  accountId       String        @map("account_id")
  personName      String        @map("person_name")
  type            LoanType
  principalAmount Decimal       @map("principal_amount") @db.Decimal(14, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(14, 2)
  description     String?
  loanDate        DateTime      @map("loan_date")
  status          LoanStatus    @default(OPEN)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id])
  payments        LoanPayment[]

  @@index([userId])
  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([loanDate])
  @@index([userId, type, status])
  @@map("loans")
}

model LoanPayment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  loanId      String   @map("loan_id")
  accountId   String   @map("account_id")
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  paymentDate DateTime @map("payment_date")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([loanId])
  @@index([accountId])
  @@index([paymentDate])
  @@map("loan_payments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
