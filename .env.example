# Puertos internos y publicos
APP_PORT=3002
NGINX_HTTP_PORT=80

# Ruta publica de Caja Bodega
APP_BASE_PATH=/caja-bodega
FRONTEND_URL=https://agroplastick.com
VITE_BASE_PATH=/caja-bodega/
VITE_API_URL=/caja-bodega/api

# MariaDB (contenedor independiente)
MARIADB_DATABASE=agroplastic_cashbox
MARIADB_USER=caja_bodega
MARIADB_PASSWORD=change_this_url_safe_db_password
MARIADB_ROOT_PASSWORD=change_this_long_random_root_password

# Autenticacion
JWT_ACCESS_SECRET=change_this_long_random_access_secret
JWT_REFRESH_SECRET=change_this_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_DOMAIN=

# Correo
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gerencia@apps-mind.com
SMTP_PASS=change_this_email_password
SMTP_FROM="Caja Bodega <gerencia@apps-mind.com>"
EMAIL_CODE_TTL_MINUTES=10

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_initial_admin_password
ADMIN_NAME=Administrador
ADMIN_DOCUMENT_SUFFIX=ADMIN
MAX_WAREHOUSE_USERS=4

# El seed usa createMany/skipDuplicates y puede ejecutarse en cada arranque.
RUN_DATABASE_SEED=true
