# Backend local conectado a MariaDB en localhost
DATABASE_URL="mysql://root:docker@127.0.0.1:3306/agroplastic_cashbox"
PORT=3002
NODE_ENV=development

# Frontend local y ruta de la aplicacion
APP_BASE_PATH=/caja-bodega
FRONTEND_URL=http://localhost:3003
VITE_BASE_PATH=/caja-bodega/
VITE_API_URL=http://localhost:3002/caja-bodega/api

# Autenticacion de desarrollo
JWT_ACCESS_SECRET=dev_access_secret_change_if_shared
JWT_REFRESH_SECRET=dev_refresh_secret_change_if_shared
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_DOMAIN=

# Correo opcional en desarrollo
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_CODE_TTL_MINUTES=10

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=123456789
SUPERADMIN_NAME=Superadministrador
MAX_WAREHOUSE_USERS=4
